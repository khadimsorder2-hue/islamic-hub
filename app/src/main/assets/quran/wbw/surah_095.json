{"surah":95,"ayahs":{"1":[{"ar":"وَالتِّينِ","tr":"শপথ তীন (ডুমুর)"},{"ar":"وَالزَّيْتُونِ","tr":"এবং যয়তুনের (জলপাই)"}],"2":[{"ar":"وَطُورِ","tr":"শপথ তুর পর্বতের"},{"ar":"سِينِينَ","tr":"সিনাই"}],"3":[{"ar":"وَهٰذَا","tr":"শপথ এই"},{"ar":"الْبَلَدِ","tr":"নগরীর"},{"ar":"الْأَمِينِ","tr":"নিরাপদ"}],"4":[{"ar":"لَقَدْ","tr":"নিশ্চয়ই"},{"ar":"خَلَقْنَا","tr":"আমরা সৃষ্টি করেছি"},{"ar":"الْإِنسٰنَ","tr":"মানুষকে"},{"ar":"فِىٓ","tr":"মধ্যে"},{"ar":"أَحْسَنِ","tr":"সুন্দরতম"},{"ar":"تَقْوِيمٍ","tr":"গঠনে"}],"5":[{"ar":"ثُمَّ","tr":"এরপরে"},{"ar":"رَدَدْنٰهُ","tr":"আমরা তাকে ফিরিয়ে দিয়েছি"},{"ar":"أَسْفَلَ","tr":"অতি নীচে"},{"ar":"سٰفِلِينَ","tr":"সব নীচুর"}],"6":[{"ar":"إِلَّا","tr":"(তবে) ব্যতিক্রম"},{"ar":"الَّذِينَ","tr":"(তাদের) যারা"},{"ar":"ءَامَنُوا","tr":"ঈমান এনেছে"},{"ar":"وَعَمِلُوا","tr":"এবং করেছে"},{"ar":"الصّٰلِحٰتِ","tr":"সৎকর্ম"},{"ar":"فَلَهُمْ","tr":"তাদের জন্য (রয়েছে)"},{"ar":"أَجْرٌ","tr":"প্রতিফল"},{"ar":"غَيْرُ","tr":"অশেষ"},{"ar":"مَمْنُونٍ","tr":"অশেষ"}],"7":[{"ar":"فَمَا","tr":"সুতরাং কিসে"},{"ar":"يُكَذِّبُكَ","tr":"তোমাকে অস্বীকার করায়"},{"ar":"بَعْدُ","tr":"এরপরে"},{"ar":"بِالدِّينِ","tr":"বিচার দিনের ব্যাপারে"}],"8":[{"ar":"أَلَيْسَ","tr":"নন কি"},{"ar":"اللَّهُ","tr":"আল্লাহ"},{"ar":"بِأَحْكَمِ","tr":"শ্রেষ্ঠ বিচারক"},{"ar":"الْحٰكِمِينَ","tr":"সব বিচারকের"}]}}