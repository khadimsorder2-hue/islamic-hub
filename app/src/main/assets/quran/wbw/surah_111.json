{"surah":111,"ayahs":{"1":[{"ar":"تَبَّتْ","tr":"ধ্বংস হোক"},{"ar":"يَدَآ","tr":"দু'হাত"},{"ar":"أَبِى","tr":"আবু"},{"ar":"لَهَبٍ","tr":"লাহাবের"},{"ar":"وَتَبَّ","tr":"এবং সেও ধ্বংস হোক"}],"2":[{"ar":"مَآ","tr":"না"},{"ar":"أَغْنٰى","tr":"কাজে আসলো"},{"ar":"عَنْهُ","tr":"তার পক্ষে"},{"ar":"مَالُهُۥ","tr":"তার সম্পদ"},{"ar":"وَمَا","tr":"আর যা"},{"ar":"كَسَبَ","tr":"সে  উপার্জন করেছিল"}],"3":[{"ar":"سَيَصْلٰى","tr":"শীঘ্রই জ্বলবে"},{"ar":"نَارًا","tr":"আগুনে"},{"ar":"ذَاتَ","tr":"সমন্বিত"},{"ar":"لَهَبٍ","tr":"শিখা"}],"4":[{"ar":"وَامْرَأَتُهُۥ","tr":"এবং তার স্ত্রীও"},{"ar":"حَمَّالَةَ","tr":"বহনকারিণী"},{"ar":"الْحَطَبِ","tr":"কাঠের"}],"5":[{"ar":"فِى","tr":"মধ্যে"},{"ar":"جِيدِهَا","tr":"তার গলার"},{"ar":"حَبْلٌ","tr":"দড়ি"},{"ar":"مِّن","tr":"থেকে"},{"ar":"مَّسَدِۢ","tr":"পাকানো"}]}}