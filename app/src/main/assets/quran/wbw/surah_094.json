{"surah":94,"ayahs":{"1":[{"ar":"أَلَمْ","tr":"করি দিই নি?"},{"ar":"نَشْرَحْ","tr":"আমরা উন্মুক্ত"},{"ar":"لَكَ","tr":"তোমার জন্যে"},{"ar":"صَدْرَكَ","tr":"তোমার বক্ষকে"}],"2":[{"ar":"وَوَضَعْنَا","tr":"এবং আমরা নামিয়েছি"},{"ar":"عَنكَ","tr":"তোমার থেকে"},{"ar":"وِزْرَكَ","tr":"তোমার ভার"}],"3":[{"ar":"الَّذِىٓ","tr":"যা"},{"ar":"أَنقَضَ","tr":"ভেঙ্গে দিচ্ছিলো"},{"ar":"ظَهْرَكَ","tr":"তোমার পিঠ"}],"4":[{"ar":"وَرَفَعْنَا","tr":"ও আমরা সুউচ্চ করেছি"},{"ar":"لَكَ","tr":"তোমার জন্যে"},{"ar":"ذِكْرَكَ","tr":"তোমার খ্যাতি/ স্মরণকে"}],"5":[{"ar":"فَإِنَّ","tr":"অতএব নিশ্চয়ই"},{"ar":"مَعَ","tr":"সাথে"},{"ar":"الْعُسْرِ","tr":"কষ্টের"},{"ar":"يُسْرًا","tr":"স্বস্তি (আছে)"}],"6":[{"ar":"إِنَّ","tr":"নিশ্চয়ই"},{"ar":"مَعَ","tr":"সাথে"},{"ar":"الْعُسْرِ","tr":"কষ্টের"},{"ar":"يُسْرًا","tr":"স্বস্তি (আছে)"}],"7":[{"ar":"فَإِذَا","tr":"অতএব যখনই"},{"ar":"فَرَغْتَ","tr":"তুমি অবসর হও"},{"ar":"فَانصَبْ","tr":"তুমি তখন ইবাদাত করো"}],"8":[{"ar":"وَإِلٰى","tr":"এবং প্রতি"},{"ar":"رَبِّكَ","tr":"তোমার রবের"},{"ar":"فَارْغَب","tr":"তখন মনোনিবেশ করো"}]}}