{"surah":105,"ayahs":{"1":[{"ar":"أَلَمْ","tr":"নাই কি"},{"ar":"تَرَ","tr":"তুমি দেখো"},{"ar":"كَيْفَ","tr":"কেমন"},{"ar":"فَعَلَ","tr":"করেছেন"},{"ar":"رَبُّكَ","tr":"তোমার রব"},{"ar":"بِأَصْحٰبِ","tr":"বাহিনীর সাথে"},{"ar":"الْفِيلِ","tr":"হাতি"}],"2":[{"ar":"أَلَمْ","tr":"নাই কি"},{"ar":"يَجْعَلْ","tr":"তিনি পরণত করে"},{"ar":"كَيْدَهُمْ","tr":"তাদের ষড়যন্ত্রকে"},{"ar":"فِى","tr":"মধ্যে"},{"ar":"تَضْلِيلٍ","tr":"নিষ্ফলতার"}],"3":[{"ar":"وَأَرْسَلَ","tr":"এবং পাঠিয়েছেন"},{"ar":"عَلَيْهِمْ","tr":"তাদের বিরুদ্ধে"},{"ar":"طَيْرًا","tr":"পাখি"},{"ar":"أَبَابِيلَ","tr":"ঝাঁকে ঝাঁকে"}],"4":[{"ar":"تَرْمِيهِم","tr":"তাদের উপর নিক্ষেপ করে"},{"ar":"بِحِجَارَةٍ","tr":"পাথরসমূহকে"},{"ar":"مِّن","tr":"হতে"},{"ar":"سِجِّيلٍ","tr":"কংকরের"}],"5":[{"ar":"فَجَعَلَهُمْ","tr":"অতঃপর তিনি তাদের করে দেন"},{"ar":"كَعَصْفٍ","tr":"ভুসির মতো"},{"ar":"مَّأْكُولِۢ","tr":"খাওয়া/ভক্ষিত"}]}}