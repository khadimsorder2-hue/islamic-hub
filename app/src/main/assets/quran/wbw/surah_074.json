ার) যে জন্যে"},{"ar":"شَآءَ","tr":"ইচ্ছে করেে"},{"ar":"مِنكُمْ","tr":"তোমাদের মধ্যে"},{"ar":"أَن","tr":"যে"},{"ar":"يَتَقَدَّمَ","tr":"অগ্রসর হবে"},{"ar":"أَوْ","tr":"অথবা"},{"ar":"يَتَأَخَّرَ","tr":"পিছিয়ে যাবে"}],"38":[{"ar":"كُلُّ","tr":"প্রত্যেক"},{"ar":"نَفْسٍۢ","tr":"ব্যক্তি"},{"ar":"بِمَا","tr":"যা বিনিময়ে"},{"ar":"كَسَبَتْ","tr":"অর্জন করেছে"},{"ar":"رَهِينَةٌ","tr":"দায়ে আবদ্ধ"}],"39":[{"ar":"إِلَّآ","tr":"ছাড়া"},{"ar":"أَصْحٰبَ","tr":"ব্যক্তিগণ"},{"ar":"الْيَمِينِ","tr":"ডানদিকস্থ"}],"40":[{"ar":"فِى","tr":"মধ্যে"},{"ar":"جَنّٰتٍ","tr":"বেহেশতের"},{"ar":"يَتَسَآءَلُونَ","tr":"জিজ্ঞাসা পরস্পরে করবে"}],"41":[{"ar":"عَنِ","tr":"সম্পর্কে"},{"ar":"الْمُجْرِمِينَ","tr":"অপরাধীদের"}],"42":[{"ar":"مَا","tr":"\"কিসে"},{"ar":"سَلَكَـكُمْ","tr":"তোমাদের প্রবেশ করিয়েছে"},{"ar":"فِى","tr":"মধ্যে"},{"ar":"سَقَرَ","tr":"দোযখের\""}],"43":[{"ar":"قَالُوا","tr":"তারা বলবে"},{"ar":"لَمْ","tr":"\"না"},{"ar":"نَكُ","tr":"ছিলাম আমরা"},{"ar":"مِنَ","tr":"অন্তর্ভূক্ত"},{"ar":"الْمُصَلِّينَ","tr":"নামাজীদের"}],"44":[{"ar":"وَلَمْ","tr":"এবং না"},{"ar":"نَكُ","tr":"আমরা"},{"ar":"نُطْعِمُ","tr":"খাওয়াতাম"},{"ar":"الْمِسْكِينَ","tr":"মিছকিনকে"}],"45":[{"ar":"وَكُنَّا","tr":"এবং আমরা আলোচনা করতাম"},{"ar":"نَخُوضُ","tr":"এবং আমরা আলোচনা করতাম"},{"ar":"مَعَ","tr":"সাথে"},{"ar":"الْخَآئِضِينَ","tr":"আলোচনাকারীদের"}],"46":[{"ar":"وَكُنَّا","tr":"এবং মিথ্যারোপ করতাম আমরা"},{"ar":"نُكَذِّبُ","tr":"এবং মিথ্যারোপ করতাম আমরা"},{"ar":"بِيَوْمِ","tr":"দিনকে"},{"ar":"الدِّينِ","tr":"প্রতিদানের"}],"47":[{"ar":"حَتّٰىٓ","tr":"শেষ পর্যন্ত"},{"ar":"أَتٰىنَا","tr":"আমাদের কাছে আসল"},{"ar":"الْيَقِينُ","tr":"দৃঢ়বিশ্বাস (মৃত্যু)\""}],"48":[{"ar":"فَمَا","tr":"না অতঃপর"},{"ar":"تَنفَعُهُمْ","tr":"তাদের কাজে আসবে"},{"ar":"شَفٰعَةُ","tr":"সুপারিশ"},{"ar":"الشّٰفِعِينَ","tr":"সুপারিশকারীদের"}],"49":[{"ar":"فَمَا","tr":"অতঃপর"},{"ar":"لَهُمْ","tr":"তাদের হয়েছে কি"},{"ar":"عَنِ","tr":"থেকে"},{"ar":"التَّذْكِرَةِ","tr":"নসীহত"},{"ar":"مُعْرِضِينَ","tr":"মুখ ফিরিয়ে নেয়"}],"50":[{"ar":"كَأَنَّهُمْ","tr":"তার