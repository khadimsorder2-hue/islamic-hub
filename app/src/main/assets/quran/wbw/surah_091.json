{"surah":91,"ayahs":{"1":[{"ar":"وَالشَّمْسِ","tr":"শপথ সূর্যের"},{"ar":"وَضُحٰىهَا","tr":"এবং তার কিরণের"}],"2":[{"ar":"وَالْقَمَرِ","tr":"শপথ চাঁদের"},{"ar":"إِذَا","tr":"যখন"},{"ar":"تَلٰىهَا","tr":"তার পিছে আসে"}],"3":[{"ar":"وَالنَّهَارِ","tr":"শপথ দিনের"},{"ar":"إِذَا","tr":"যখন"},{"ar":"جَلّٰىهَا","tr":"তাকে প্রকাশ করে"}],"4":[{"ar":"وَالَّيْلِ","tr":"শপথ রাতের"},{"ar":"إِذَا","tr":"যখন"},{"ar":"يَغْشٰىهَا","tr":"তাকে ঢেকে ফেলে"}],"5":[{"ar":"وَالسَّمَآءِ","tr":"শপথ আকাশের"},{"ar":"وَمَا","tr":"এবং যিনি"},{"ar":"بَنٰىهَا","tr":"তা তৈরি করেছেন"}],"6":[{"ar":"وَالْأَرْضِ","tr":"শপথ পৃথিবীর"},{"ar":"وَمَا","tr":"এবং যিনি"},{"ar":"طَحٰىهَا","tr":"তা বিস্তৃত করেছেন"}],"7":[{"ar":"وَنَفْسٍ","tr":"শপথ মানুষের"},{"ar":"وَمَا","tr":"এবং যিনি"},{"ar":"سَوّٰىهَا","tr":"তাকে সুঠাম করেছেন"}],"8":[{"ar":"فَأَلْهَمَهَا","tr":"অতঃপর তাকে জ্ঞান দিয়েছেন"},{"ar":"فُجُورَهَا","tr":"তার মন্দকাজ"},{"ar":"وَتَقْوٰىهَا","tr":"ও তার তাকওয়া (সম্পর্কে )"}],"9":[{"ar":"قَدْ","tr":"নিশ্চয়ই"},{"ar":"أَفْلَحَ","tr":"সফল হলো"},{"ar":"مَن","tr":"যে"},{"ar":"زَكّٰىهَا","tr":"তাকে পবিত্র করলো"}],"10":[{"ar":"وَقَدْ","tr":"এবং নিশ্চয়ই"},{"ar":"خَابَ","tr":"ব্যর্থ হলো"},{"ar":"مَن","tr":"যে"},{"ar":"دَسّٰىهَا","tr":"তাকে কলুষিত করলো"}],"11":[{"ar":"كَذَّبَتْ","tr":"মিথ্যারোপ করেছিল"},{"ar":"ثَمُودُ","tr":"সামূদ জাতি"},{"ar":"بِطَغْوٰىهَآ","tr":"তার অবাধ্যতাবশতঃ"}],"12":[{"ar":"إِذِ","tr":"যখন"},{"ar":"انۢبَعَثَ","tr":"(তৎপর হয়ে)উঠলো"},{"ar":"أَشْقٰىهَا","tr":"তার সবচেয়ে হতভাগা ব্যক্তি"}],"13":[{"ar":"فَقَالَ","tr":"অতঃপর বললো"},{"ar":"لَهُمْ","tr":"তাদেরকে"},{"ar":"رَسُولُ","tr":"রাসূল"},{"ar":"اللَّهِ","tr":"আল্লাহর"},{"ar":"نَاقَةَ","tr":"\"(সাবধান)উষ্ট্রীকে"},{"ar":"اللَّهِ","tr":"আল্লাহর (স্পর্শ করো না)"},{"ar":"وَسُقْيٰهَا","tr":"ও তার পানি পান করায় (বাধা দিও না)\""}],"14":[{"ar":"فَكَذَّبُوهُ","tr":"কিন্তু তারা তাকে  মিথ্যা ভাবলো"},{"ar":"فَعَقَرُوهَا","tr":"অতঃপর তারা তাকে  হত্যা করলো"},{"ar":"فَدَمْدَمَ","tr":"ফলে ধ্বংস করে দিলেন"},{"ar":"عَلَيْهِمْ","tr":"তাদেরকে"},{"ar":"رَبُّهُ