{"surah":107,"ayahs":{"1":[{"ar":"أَرَءَيْتَ","tr":"তুমি কি দেখেছ"},{"ar":"الَّذِى","tr":"(তাকে) যে"},{"ar":"يُكَذِّبُ","tr":"মিথ্যা অভিহিত করে"},{"ar":"بِالدِّينِ","tr":"বিচার দিনকে"}],"2":[{"ar":"فَذٰلِكَ","tr":"সে তো সে-ই"},{"ar":"الَّذِى","tr":"যে"},{"ar":"يَدُعُّ","tr":"ধাক্কা দেয়"},{"ar":"الْيَتِيمَ","tr":"ইয়াতিমকে"}],"3":[{"ar":"وَلَا","tr":"এবং না"},{"ar":"يَحُضُّ","tr":"উৎসাহিত করে"},{"ar":"عَلٰى","tr":"ব্যাপারে"},{"ar":"طَعَامِ","tr":"খাদ্যদানের"},{"ar":"الْمِسْكِينِ","tr":"অভাবগ্রস্তকে"}],"4":[{"ar":"فَوَيْلٌ","tr":"অতএব দুর্ভোগ"},{"ar":"لِّلْمُصَلِّينَ","tr":"(ঐসব) সালাত আদায়কারীদের জন্য"}],"5":[{"ar":"الَّذِينَ","tr":"যাদের (বৈশিষ্ট্য হলো)"},{"ar":"هُمْ","tr":"তারা"},{"ar":"عَن","tr":"সম্বন্ধে"},{"ar":"صَلَاتِهِمْ","tr":"তাদের সালাত"},{"ar":"سَاهُونَ","tr":"উদাসীন"}],"6":[{"ar":"الَّذِينَ","tr":"যাদের (বৈশিষ্ট্য হলো)"},{"ar":"هُمْ","tr":"তারা"},{"ar":"يُرَآءُونَ","tr":"লোকদেখানোর (কাজ করে)"}],"7":[{"ar":"وَيَمْنَعُونَ","tr":"এবং দেওয়া হতে বিরত থাকে"},{"ar":"الْمَاعُونَ","tr":"সংসারের প্রয়োজনীয় ছোটখাটো জিনিসের"}]}}