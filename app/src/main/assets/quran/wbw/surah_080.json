{"surah":80,"ayahs":{"1":[{"ar":"عَبَسَ","tr":"সে ভ্রুকুঞ্চিত করল"},{"ar":"وَتَوَلّٰىٓ","tr":"ও (মুখ ফিরালো) অনাগ্রহ দেখালো"}],"2":[{"ar":"أَن","tr":"(এ জন্যে) যে"},{"ar":"جَآءَهُ","tr":"তার (কাছে) এসেছে"},{"ar":"الْأَعْمٰى","tr":"এক অন্ধ"}],"3":[{"ar":"وَمَا","tr":"এবং কিসে"},{"ar":"يُدْرِيكَ","tr":"তোমাকে জানাবে"},{"ar":"لَعَلَّهُۥ","tr":"সে হয়তো"},{"ar":"يَزَّكّٰىٓ","tr":"পরিশুদ্ধ হতো"}],"4":[{"ar":"أَوْ","tr":"বা"},{"ar":"يَذَّكَّرُ","tr":"উপদেশ গ্রহণ করতো"},{"ar":"فَتَنفَعَهُ","tr":"তাকে অতঃপর উপকার দিত"},{"ar":"الذِّكْرٰىٓ","tr":"উপদেশ"}],"5":[{"ar":"أَمَّا","tr":"পক্ষান্তরে"},{"ar":"مَنِ","tr":"যে"},{"ar":"اسْتَغْنٰى","tr":"বেপরোয়া হলো (উন্নাসিকতা দেখালো)"}],"6":[{"ar":"فَأَنتَ","tr":"অথচ তুমি"},{"ar":"لَهُۥ","tr":"তার জন্যে"},{"ar":"تَصَدّٰى","tr":"মনযোগ দিচ্ছো"}],"7":[{"ar":"وَمَا","tr":"কিন্তু নাই"},{"ar":"عَلَيْكَ","tr":"তোমার উপর (দায়িত্ব)"},{"ar":"أَلَّا","tr":"যদি না"},{"ar":"يَزَّ كّٰى","tr":"সে পরিশুদ্ধ হয়"}],"8":[{"ar":"وَأَمَّا","tr":"আর অন্যপক্ষে"},{"ar":"مَن","tr":"যে"},{"ar":"جَآءَكَ","tr":"তোমার কাছে আসল"},{"ar":"يَسْعٰى","tr":"দৌড়ে"}],"9":[{"ar":"وَهُوَ","tr":"এবং সে"},{"ar":"يَخْشٰى","tr":"ভয় করে"}],"10":[{"ar":"فَأَنتَ","tr":"অথচ তুমি"},{"ar":"عَنْهُ","tr":"তার থেকে"},{"ar":"تَلَهّٰى","tr":"অনীহা প্রকাশ করছ"}],"11":[{"ar":"كَلَّآ","tr":"কখনও না"},{"ar":"إِنَّهَا","tr":"নিশ্চয়ই তা"},{"ar":"تَذْكِرَةٌ","tr":"উপদেশ"}],"12":[{"ar":"فَمَن","tr":"অতএব যে"},{"ar":"شَآءَ","tr":"চায়"},{"ar":"ذَكَرَهُۥ","tr":"(তা স্মরণ করবে) তা গ্রহণ করবে"}],"13":[{"ar":"فِى","tr":"মধ্যে (লিপিবদ্ধ)"},{"ar":"صُحُفٍ","tr":"সহিফাসমূহের"},{"ar":"مُّكَرَّمَةٍ","tr":"(যা) সম্মানিত"}],"14":[{"ar":"مَّرْفُوعَةٍ","tr":"উচ্চ মর্যাদাসম্পন্ন"},{"ar":"مُّطَهَّرَةٍۢ","tr":"পবিত্র"}],"15":[{"ar":"بِأَيْدِى","tr":"হাতে"},{"ar":"سَفَرَةٍ","tr":"দূতদের"}],"16":[{"ar":"كِرَامٍۢ","tr":"সম্মানিত"},{"ar":"بَرَرَةٍ","tr":"সততাসম্পন্ন"}],"17":[{"ar":"قُتِلَ","tr":"ধ্বংস হোক"},{"ar":"الْإِنسٰنُ","tr":"মানুষ"},{"ar":"مَآ","tr":"কতই না"},{"ar":"أَكْفَرَهُۥ","tr":"তা অমান্যকারী"}],"