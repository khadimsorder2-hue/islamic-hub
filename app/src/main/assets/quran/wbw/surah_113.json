{"surah":113,"ayahs":{"1":[{"ar":"قُلْ","tr":"বলো"},{"ar":"أَعُوذُ","tr":"\"আমি আশ্রয় চাই"},{"ar":"بِرَبِّ","tr":"স্রষ্টার নিকট"},{"ar":"الْفَلَقِ","tr":"প্রভাতের"}],"2":[{"ar":"مِن","tr":"হতে"},{"ar":"شَرِّ","tr":"অনিষ্ট"},{"ar":"مَا","tr":"যা"},{"ar":"خَلَقَ","tr":"তিনি সৃষ্টি করেছেন"}],"3":[{"ar":"وَمِن","tr":"এবং হতে"},{"ar":"شَرِّ","tr":"অনিষ্ট"},{"ar":"غَاسِقٍ","tr":"রাতের অন্ধকারের"},{"ar":"إِذَا","tr":"যখন"},{"ar":"وَقَبَ","tr":"তা গভীর হয়"}],"4":[{"ar":"وَمِن","tr":"এবং হতে"},{"ar":"شَرِّ","tr":"অনিষ্ট"},{"ar":"النَّفّٰثٰتِ","tr":"ফুঁকদানকারীর (রাতের) অনিষ্ট"},{"ar":"فِى","tr":"মধ্যে"},{"ar":"الْعُقَدِ","tr":"গিঁটগুলোর"}],"5":[{"ar":"وَمِن","tr":"এবং হতে"},{"ar":"شَرِّ","tr":"অনিষ্ট"},{"ar":"حَاسِدٍ","tr":"হিংসুকের"},{"ar":"إِذَا","tr":"যখন"},{"ar":"حَسَدَ","tr":"সে হিংসা করে\""}]}}