{"surah":100,"ayahs":{"1":[{"ar":"وَالْعٰدِيٰتِ","tr":"শপথ ধাবমান (ঘোড়াগুলোর)"},{"ar":"ضَبْحًا","tr":"(যারা দৌঁড়ায়) উর্ধ্বশ্বাসে"}],"2":[{"ar":"فَالْمُورِيٰتِ","tr":"অতঃপর যারা বিচ্ছুরিত করে"},{"ar":"قَدْحًا","tr":"(ক্ষুরাঘাতে) আগুনের ফুলকি"}],"3":[{"ar":"فَالْمُغِيرٰتِ","tr":"অতঃপর যারা অভিযান চালায়"},{"ar":"صُبْحًا","tr":"প্রভাতে"}],"4":[{"ar":"فَأَثَرْنَ","tr":"অতঃপর উড়ায়"},{"ar":"بِهِۦ","tr":"এভাবে"},{"ar":"نَقْعًا","tr":"ধুলোবালি"}],"5":[{"ar":"فَوَسَطْنَ","tr":"অতঃপর (ঢুকে পড়ে) অভ্যন্তরে"},{"ar":"بِهِۦ","tr":"এভাবে"},{"ar":"جَمْعًا","tr":"(শত্রু)দলে"}],"6":[{"ar":"إِنَّ","tr":"নিশ্চয়ই"},{"ar":"الْإِنسٰنَ","tr":"মানুষ"},{"ar":"لِرَبِّهِۦ","tr":"তার রবের প্রতি"},{"ar":"لَكَنُودٌ","tr":"অবশ্যই অকৃতজ্ঞ"}],"7":[{"ar":"وَإِنَّهُۥ","tr":"এবং সে নিশ্চয়ই"},{"ar":"عَلٰى","tr":"বিষয়ে"},{"ar":"ذٰلِكَ","tr":"এর"},{"ar":"لَشَهِيدٌ","tr":"অবশ্যই সাক্ষী"}],"8":[{"ar":"وَإِنَّهُۥ","tr":"এবং নিশ্চয়ই সে"},{"ar":"لِحُبِّ","tr":"মহব্বতের ক্ষেত্রে"},{"ar":"الْخَيْرِ","tr":"ধন-সম্পদের"},{"ar":"لَشَدِيدٌ","tr":"বড়ই প্রবল"}],"9":[{"ar":"أَفَلَا","tr":"তবে কি না"},{"ar":"يَعْلَمُ","tr":"সে জানে"},{"ar":"إِذَا","tr":"যখন"},{"ar":"بُعْثِرَ","tr":"উঠানো হবে"},{"ar":"مَا","tr":"যা কিছু"},{"ar":"فِى","tr":"মধ্যে আছে"},{"ar":"الْقُبُورِ","tr":"কবরগুলোর"}],"10":[{"ar":"وَحُصِّلَ","tr":"এবং প্রকাশ করা হবে"},{"ar":"مَا","tr":"যা কিছু"},{"ar":"فِى","tr":"মধ্যে আছে"},{"ar":"الصُّدُورِ","tr":"অন্তরসমূহের"}],"11":[{"ar":"إِنَّ","tr":"নিশ্চয়ই"},{"ar":"رَبَّهُم","tr":"তাদের রব"},{"ar":"بِهِمْ","tr":"তাদের সাথে"},{"ar":"يَوْمَئِذٍ","tr":"সেদিন"},{"ar":"لَّخَبِيرُۢ","tr":"অবশ্যই তা ভালো করেই জানেন"}]}}