<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IslamicHub.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.IslamicHub.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary_violet_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.IslamicHub.App</item>
    </style>
</resources>
